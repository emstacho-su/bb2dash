SUPABASE_URL=https://goultdzqcavefcgnifdy.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...     # safe for browser/crawler (insert-only policies)
SUPABASE_SERVICE_KEY=                            # server-side only, never in a browser or this repo
BB_USER_ID=_21025199_1
BB_BASE=https://blackboard.syracuse.edu
BB_ICAL_FEED_URL=                                # from Blackboard calendar share settings
# scripts/db-test.mjs, as db_test_runner. Direct or session pooler (port 5432), never the
# transaction pooler (6543): units run `set local role` mid-transaction. Both query parameters are
# required — pg 8.23 reads a bare sslmode=require as verify-full, and the Supabase pooler chains to
# a private root, so without uselibpqcompat=true the connection dies with "self-signed certificate
# in certificate chain". The runner refuses a DSN with no sslmode, or with disable/allow/prefer.
# The real value, password and all, lives only in the gitignored .env.local.
BB2DASH_TEST_DB_URL=postgresql://db_test_runner.goultdzqcavefcgnifdy:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
