{
  "name": "bb2dash-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell around the deployed bb2dash web app: window, tray, notifications, Sync terminal.",
  "author": "Evan Stachowiak <estack318@gmail.com>",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "pack": "npm run build && electron-builder --dir",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.9.2",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
