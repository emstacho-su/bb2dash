# bb2dash materials MCP server — reference only. Real values live in the gitignored
# repo-root .env and in the server's env block in ~/.claude.json. Never commit either.
#
# This server talks to bb2dash (goultdzqcavefcgnifdy) and NOTHING else. The harness RAG
# (harness-memory, hqkytnyiiuxovnnyixye) is a different corpus embedded with a different
# model; loadConfig refuses a URL that names it.

# Project REST/Functions base URL.
SUPABASE_URL=https://goultdzqcavefcgnifdy.supabase.co

# Secret (service-role) key. Server-side only — this is a local stdio process driven by
# Claude Code, never a browser. It is needed because bb_file_text and the embeddings are
# readable only by `authenticated`/service, and `search` runs behind verify_jwt.
# SUPABASE_SERVICE_KEY is accepted as a legacy alias.
SUPABASE_SERVICE_ROLE=sb_secret_REPLACE_ME

# Optional tuning. Defaults shown.
# BB2DASH_MIN_SIMILARITY=0.78     # cosine floor on vector evidence; "none" disables
# BB2DASH_DEFAULT_LIMIT=10
# BB2DASH_MAX_LIMIT=50
# BB2DASH_TIMEOUT_MS=30000        # gte-small cold start is ~1.5 s; leave headroom
